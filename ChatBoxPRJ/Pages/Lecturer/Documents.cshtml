@page
@using ChatBoxPRJ.Business.Domain
@model ChatBoxPRJ.Pages.Lecturer.DocumentsModel
@{ ViewData["Title"] = "Kho tài liệu"; }
<div class="page-heading"><div><span class="eyebrow">KNOWLEDGE PIPELINE</span><h1>Quản lý tài liệu</h1><p>Upload, trích xuất, chunk và lập chỉ mục tri thức theo đúng phạm vi môn học.</p></div><span class="live-pill"><i></i> Theo dõi trực tiếp</span></div>
@if (Model.Flash is not null) { <div class="alert alert-info">@Model.Flash</div> }
<div class="document-layout"><aside class="panel upload-panel"><h2>Bắt đầu xử lý</h2>
<form method="post" enctype="multipart/form-data" asp-page-handler="Upload" class="form-stack" id="uploadForm">
    <label asp-for="CourseId">Môn học được cấp quyền</label><select asp-for="CourseId" class="form-select" required><option value="">— Chọn môn —</option>@foreach (var c in Model.Courses) { <option value="@c.Id">@c.Code · @c.Name</option> }</select>
    <label class="drop-zone"><span class="drop-icon">⇧</span><b>Chọn PDF, DOCX hoặc TXT</b><small>Tối đa 100 MB · PDF scan ảnh sẽ bị từ chối</small><input asp-for="UploadFile" accept=".pdf,.docx,.txt" required /></label>
    <label class="switch-row"><input asp-for="Overwrite" /><span>Ghi đè nếu trùng tên nhưng khác nội dung</span></label>
    <button class="btn btn-primary btn-lg" id="uploadButton">Bắt đầu xử lý</button>
</form>
<div class="upload-progress" id="uploadProgress" hidden>
    <div class="progress-copy"><b id="uploadProgressText">Đang upload…</b><span id="uploadPercent">0%</span></div>
    <div class="progress-track"><i id="uploadProgressBar"></i></div>
</div>
<div class="pipeline-note"><b>Pipeline</b><span>SHA-256 → Extract → Chunk → Embed → Index</span></div></aside>
<section class="panel grow"><div class="panel-title"><div><h2>Tài liệu đã upload</h2><p>Chỉ file “Hoàn thành” mới xuất hiện với sinh viên.</p></div><form method="get"><select asp-for="CourseId" class="form-select" onchange="this.form.submit()"><option value="">Tất cả môn</option>@foreach (var c in Model.Courses) { <option value="@c.Id">@c.Code</option> }</select></form></div>
<div class="table-wrap"><table class="data-table"><thead><tr><th>Tài liệu</th><th>Môn</th><th>Ngày tải</th><th>Trạng thái</th><th></th></tr></thead><tbody>
@foreach (var d in Model.Documents) { var cls = d.Status.ToString().ToLowerInvariant(); <tr data-document-id="@d.Id"><td><div class="file-cell"><span>📄</span><div><b>@d.FileName</b>@if (d.FailureReason is not null) { <small title="@d.FailureReason">@d.FailureReason</small> }</div></div></td><td>@d.CourseName</td><td>@d.UploadedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td><td><span class="status @cls">@d.Status</span>@if (d.Status == DocumentStatus.Processing) { <div class="processing-progress"><div class="progress-copy"><small class="processing-message">Đang chờ cập nhật…</small><b class="processing-percent">0%</b></div><div class="progress-track"><i></i></div></div> }</td><td><div class="row-actions">@if (d.Status == DocumentStatus.Completed) { <a class="icon-btn" asp-page="/Lecturer/Chunks" asp-route-documentId="@d.Id" title="Xem các đoạn chunk">✂️</a> }<form method="post" asp-page-handler="Delete" onsubmit="return confirm('Xóa hoàn toàn tài liệu và tri thức của file?')"><input type="hidden" name="documentId" value="@d.Id"/><input type="hidden" name="courseId" value="@Model.CourseId"/><button class="icon-btn" title="Xóa">🗑</button></form></div></td></tr> }
@if (!Model.Documents.Any()) { <tr><td colspan="5"><div class="empty-state compact"><span>📭</span><h3>Chưa có tài liệu</h3><p>Upload tệp đầu tiên để khởi tạo kho tri thức.</p></div></td></tr> }
</tbody></table></div></section></div>
@section Scripts { <script>
const uploadForm = document.getElementById('uploadForm');
uploadForm?.addEventListener('submit', event => {
    event.preventDefault();
    const panel = document.getElementById('uploadProgress');
    const bar = document.getElementById('uploadProgressBar');
    const percent = document.getElementById('uploadPercent');
    const text = document.getElementById('uploadProgressText');
    const button = document.getElementById('uploadButton');
    panel.hidden = false;
    button.disabled = true;
    const request = new XMLHttpRequest();
    request.open('POST', uploadForm.action);
    request.upload.addEventListener('progress', e => {
        if (!e.lengthComputable) return;
        const value = Math.round(e.loaded / e.total * 100);
        bar.style.width = `${value}%`;
        percent.textContent = `${value}%`;
        text.textContent = value === 100 ? 'Upload hoàn tất, đang ghi nhận…' : 'Đang upload…';
    });
    request.addEventListener('load', () => {
        if (request.status >= 200 && request.status < 400) location.assign(request.responseURL || location.href);
        else { text.textContent = 'Upload không thành công. Vui lòng thử lại.'; button.disabled = false; }
    });
    request.addEventListener('error', () => { text.textContent = 'Mất kết nối khi upload. Vui lòng thử lại.'; button.disabled = false; });
    request.send(new FormData(uploadForm));
});

function updateProcessing(data) {
    const row = document.querySelector(`[data-document-id="${data.documentId}"]`);
    if (!row) return;
    const status = row.querySelector('.status');
    status.className = `status ${data.status.toLowerCase()}`;
    status.textContent = data.status;
    const progress = row.querySelector('.processing-progress');
    if (progress) {
        progress.querySelector('.processing-percent').textContent = `${data.progress}%`;
        progress.querySelector('.processing-message').textContent = data.message || 'Đang xử lý…';
        progress.querySelector('.progress-track i').style.width = `${data.progress}%`;
    }
    if (data.status !== 'Processing') setTimeout(() => location.reload(), 700);
}

async function connectDocumentHub() {
    try {
        const response = await fetch('/hubs/documents/negotiate?negotiateVersion=1', { method: 'POST' });
        if (!response.ok) throw new Error('Không thể kết nối tiến độ');
        const negotiation = await response.json();
        const protocol = location.protocol === 'https:' ? 'wss' : 'ws';
        const socket = new WebSocket(`${protocol}://${location.host}/hubs/documents?id=${encodeURIComponent(negotiation.connectionToken)}`);
        socket.addEventListener('open', () => socket.send('{"protocol":"json","version":1}\u001e'));
        socket.addEventListener('message', event => {
            event.data.split('\u001e').filter(Boolean).forEach(raw => {
                const message = JSON.parse(raw);
                if (message.type === 1 && message.target === 'documentStatusChanged') updateProcessing(message.arguments[0]);
            });
        });
        socket.addEventListener('close', () => setTimeout(connectDocumentHub, 1500));
    } catch { setTimeout(connectDocumentHub, 1500); }
}
connectDocumentHub();
</script> }
