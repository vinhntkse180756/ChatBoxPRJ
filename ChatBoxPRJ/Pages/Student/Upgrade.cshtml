@page
@model ChatBoxPRJ.Pages.Student.UpgradeModel
@{ ViewData["Title"] = "Nâng cấp gói"; }
<section class="upgrade-page">
    <header class="upgrade-hero">
        <span class="eyebrow">GÓI ĐĂNG KÝ</span>
        <h1>Chọn gói phù hợp nhu cầu học tập</h1>
        <p>Free để trải nghiệm. Nâng Pro khi cần hỏi nhiều hơn mỗi ngày — thanh toán qua VNPay.</p>
        <div class="upgrade-current">
            <span>Đang dùng</span>
            <b>@Model.Current.PackageName</b>
            <i>·</i>
            <em>@Model.Current.QuestionsPerDay.ToString("N0") câu/ngày</em>
            @if (Model.Current.EndsAtUtc is { } ends)
            {
                <i>·</i>
                <em>hết hạn @ends.ToLocalTime().ToString("dd/MM/yyyy")</em>
            }
        </div>
    </header>

    @if (!string.IsNullOrWhiteSpace(Model.Flash))
    {
        <div class="alert alert-@Model.FlashType upgrade-alert" role="alert">@Model.Flash</div>
    }

    @if (!Model.VnPayConfigured)
    {
        <div class="alert alert-warning upgrade-alert" role="alert">
            VNPay chưa cấu hình. Điền <code>VnPay:TmnCode</code> và <code>VnPay:HashSecret</code> trong appsettings để thanh toán Pro.
        </div>
    }

    <div class="upgrade-grid">
        @foreach (var package in Model.Packages)
        {
            <article class="upgrade-card @(package.IsCurrent ? "current" : "") @(package.Code == "PRO" ? "featured" : "")">
                <div class="upgrade-card-top">
                    @if (package.Code == "PRO")
                    {
                        <span class="upgrade-badge">Phổ biến</span>
                    }
                    else
                    {
                        <span class="upgrade-badge muted">Cơ bản</span>
                    }
                    <h2>@package.Name</h2>
                    <div class="upgrade-price">
                        @if (package.PriceVnd <= 0)
                        {
                            <b>0đ</b><span>/mãi mãi</span>
                        }
                        else
                        {
                            <b>@package.PriceVnd.ToString("N0")đ</b><span>/@package.DurationDays ngày</span>
                        }
                    </div>
                    <p>@package.Description</p>
                </div>
                <ul>
                    <li><strong>@package.QuestionsPerDay.ToString("N0")</strong> câu hỏi mỗi ngày</li>
                    <li>@(package.PriceVnd <= 0 ? "Không cần thanh toán" : "Thanh toán an toàn qua VNPay")</li>
                    <li>Hỏi đáp trong phạm vi tài liệu môn học</li>
                </ul>
                <div class="upgrade-card-action">
                @if (package.IsCurrent)
                {
                    <button class="btn btn-outline-secondary" disabled>Gói hiện tại</button>
                }
                else if (package.PriceVnd <= 0)
                {
                    <form method="post" asp-page-handler="DowngradeFree" onsubmit="return confirm('Hủy gói đang dùng và chuyển về Free? Phần thời gian còn lại sẽ không được hoàn tiền.');">
                        <button class="btn btn-outline-secondary" type="submit">Chuyển về Free</button>
                    </form>
                }
                else
                {
                    <form method="post" asp-page-handler="Checkout">
                        <input type="hidden" name="packageId" value="@package.Id" />
                        <button class="btn btn-primary" type="submit" @(Model.VnPayConfigured ? null : "disabled")>
                            Thanh toán VNPay
                        </button>
                    </form>
                }
                </div>
            </article>
        }
    </div>
</section>
