@page
@model ChatBoxPRJ.Pages.Student.ReceiptModel
@{
    ViewData["Title"] = "Kết Quả Thanh Toán";
}

<div class="auth-shell" style="min-height: auto; padding: 40px 0;">
    <div class="auth-card" style="width: min(540px, 100%); text-align: center; align-items: center;">
        
        @if (Model.Status == "Completed")
        {
            <div style="width: 72px; height: 72px; background: #e6f6ec; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin-bottom: 20px; font-size: 2.2rem; color: #2e7d32;">
                ✓
            </div>
            <span class="eyebrow" style="color: #2e7d32;">PAYMENT SUCCESS</span>
            <h1 style="font-size: 1.8rem; margin-top: 8px;">Thanh toán thành công</h1>
            <p style="color: var(--muted); margin-bottom: 28px;">Cảm ơn bạn đã sử dụng dịch vụ. Giao dịch đã được ghi nhận thành công.</p>
        }
        else
        {
            <div style="width: 72px; height: 72px; background: #ffebee; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin-bottom: 20px; font-size: 2.2rem; color: #c62828;">
                ✕
            </div>
            <span class="eyebrow" style="color: #c62828;">PAYMENT FAILED</span>
            <h1 style="font-size: 1.8rem; margin-top: 8px;">Giao dịch không thành công</h1>
            <p style="color: var(--muted); margin-bottom: 28px;">Thanh toán đã bị hủy hoặc gặp lỗi trong quá trình xử lý.</p>
        }

        <div class="panel" style="width: 100%; padding: 20px; box-shadow: none; border: 1.5px solid var(--line); border-radius: var(--radius-md); text-align: left; margin-bottom: 28px; background: #fafbfc;">
            <div style="display: flex; justify-content: space-between; margin-bottom: 12px;">
                <span style="color: var(--muted); font-weight: 500;">Mã giao dịch</span>
                <span style="font-weight: 700; color: var(--ink);">@Model.TransactionNo</span>
            </div>
            <div style="display: flex; justify-content: space-between; margin-bottom: 12px;">
                <span style="color: var(--muted); font-weight: 500;">Gói cước</span>
                <span style="font-weight: 700; color: var(--ink);">@Model.PackageName</span>
            </div>
            @if (Model.Status == "Completed")
            {
                <div style="display: flex; justify-content: space-between; margin-bottom: 12px;">
                    <span style="color: var(--muted); font-weight: 500;">Tín dụng nạp thêm</span>
                    <span style="font-weight: 800; color: #2e7d32;">🪙 +@Model.CreditsAdded Credits</span>
                </div>
            }
            <div style="display: flex; justify-content: space-between; margin-bottom: 12px; border-top: 1px dashed var(--line); padding-top: 12px;">
                <span style="color: var(--muted); font-weight: 500;">Số tiền</span>
                <span style="font-weight: 700; color: var(--ink);">@Model.Amount.ToString("N0") đ</span>
            </div>
            <div style="display: flex; justify-content: space-between; margin-bottom: 12px;">
                <span style="color: var(--muted); font-weight: 500;">Thời gian giao dịch</span>
                <span style="font-weight: 700; color: var(--ink);">@Model.CreatedAtLocal</span>
            </div>
            <div style="display: flex; justify-content: space-between;">
                <span style="color: var(--muted); font-weight: 500;">Trạng thái</span>
                @if (Model.Status == "Completed")
                {
                    <span class="status completed" style="font-size: 0.8rem; padding: 3px 10px;">Thành công</span>
                }
                else
                {
                    <span class="status failed" style="font-size: 0.8rem; padding: 3px 10px;">Thất bại / Hủy</span>
                }
            </div>
        </div>

        <div style="display: flex; gap: 14px; width: 100%;">
            <a class="btn btn-primary" style="flex: 1; height: 46px; display: inline-flex; align-items: center; justify-content: center; font-weight: 700;" asp-page="/Student/Chat">
                Vào phòng chat
            </a>
            <a class="btn" style="flex: 1; border: 1.5px solid var(--line); color: var(--ink); height: 46px; display: inline-flex; align-items: center; justify-content: center; font-weight: 700;" asp-page="/Student/Packages">
                Xem lịch sử nạp
            </a>
        </div>
    </div>
</div>
