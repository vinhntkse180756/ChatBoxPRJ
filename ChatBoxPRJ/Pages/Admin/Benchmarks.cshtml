@page
@model ChatBoxPRJ.Pages.Admin.BenchmarksModel
@{ ViewData["Title"] = "Benchmarks & Metrics"; }
<div class="page-heading">
    <div>
        <span class="eyebrow">EVALUATION</span>
        <h1>Benchmarks &amp; Metrics</h1>
        <p>Chạy test set RAG và đo Latency, TopScore, Hit, Reject (Admin only).</p>
    </div>
</div>

@if (Model.Flash is not null)
{
    <div class="alert alert-@(Model.FlashType ?? "info")">@Model.Flash</div>
}

<div class="panel report-filter benchmark-filter">
    <form method="get" class="benchmark-filter-row" id="courseFilterForm">
        <div class="benchmark-field">
            <label asp-for="CourseId">Môn học</label>
            <select asp-for="CourseId" asp-items="Model.CourseOptions" class="form-select" onchange="this.form.submit()">
                <option value="">— Chọn môn —</option>
            </select>
        </div>
    </form>
    <form method="post" asp-page-handler="Run" class="benchmark-filter-row">
        <input type="hidden" asp-for="CourseId" />
        <div class="benchmark-field">
            <label asp-for="DocumentId">Tài liệu (Completed)</label>
            <select asp-for="DocumentId" asp-items="Model.DocumentOptions" class="form-select">
                <option value="">— Tự chọn tài liệu đầu —</option>
            </select>
        </div>
        <div class="benchmark-actions">
            <button class="btn btn-primary" type="submit">Chạy benchmark</button>
        </div>
    </form>
    <p class="benchmark-hint">Test set: <code>Data/benchmark-questions.json</code> · Cần ≥ 1 tài liệu Completed trên môn đã chọn.</p>
</div>

@if (Model.SelectedRun is null)
{
    <div class="empty-state compact panel grow">
        <span>📉</span>
        <h2>Chưa có lần chạy nào</h2>
        <p>Chọn môn/tài liệu rồi bấm <b>Chạy benchmark</b>.</p>
    </div>
}
else
{
    var run = Model.SelectedRun;
    <div class="report-kpi-grid">
        <article class="report-kpi"><span>Số câu</span><b>@run.QuestionCount</b></article>
        <article class="report-kpi"><span>Hit</span><b>@run.HitCount</b></article>
        <article class="report-kpi"><span>Reject</span><b>@run.RejectCount</b></article>
        <article class="report-kpi"><span>Đúng kỳ vọng</span><b>@run.ExpectationMetCount</b></article>
        <article class="report-kpi accent"><span>Avg Latency</span><b>@run.AverageLatencyMs.ToString("0") ms</b></article>
        <article class="report-kpi accent"><span>Avg TopScore</span><b>@run.AverageTopScore.ToString("0.000")</b></article>
    </div>

    <div class="report-chart-grid" style="margin-bottom:22px">
        <section class="panel report-chart-card">
            <h2>Latency theo câu hỏi</h2>
            <p>Thời gian xử lý RAG từng câu (ms).</p>
            <canvas id="latencyChart" height="120"></canvas>
        </section>
        <section class="panel report-chart-card">
            <h2>Hit / Reject</h2>
            <p>Phân bố Hit, Reject và Miss trong lần chạy.</p>
            <div class="report-doughnut-wrap"><canvas id="hitRejectChart"></canvas></div>
        </section>
        <section class="panel report-chart-card" style="grid-column:1/-1">
            <h2>TopScore theo câu hỏi</h2>
            <p>Điểm similarity cao nhất retrieve được cho từng câu.</p>
            <canvas id="topScoreChart" height="90"></canvas>
        </section>
    </div>

    <div class="split-layout">
        <section class="panel">
            <h2>Lần chạy gần đây</h2>
            @if (Model.RecentRuns.Count == 0)
            {
                <p class="text-muted">Chưa có dữ liệu.</p>
            }
            else
            {
                <div class="benchmark-run-list">
                @foreach (var item in Model.RecentRuns)
                {
                    <a class="benchmark-run-item @(run.Id == item.Id ? "active" : null)"
                       asp-page="/Admin/Benchmarks"
                       asp-route-runId="@item.Id"
                       asp-route-courseId="@Model.CourseId">
                        <b>@item.CourseCode</b>
                        <small>@item.StartedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm") · Hit @item.HitCount/@item.QuestionCount</small>
                        <span>@item.AverageLatencyMs.ToString("0") ms</span>
                    </a>
                }
                </div>
            }
        </section>

        <section class="panel grow">
            <div class="panel-title">
                <div>
                    <h2>Chi tiết lần chạy</h2>
                    <p>@run.CourseCode · @run.DocumentFileName · bởi @run.StartedByCode</p>
                </div>
            </div>
            <div class="table-wrap">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Câu hỏi</th>
                            <th>Latency</th>
                            <th>TopScore</th>
                            <th>Hit</th>
                            <th>Reject</th>
                            <th>Kỳ vọng</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var row in run.Results)
                    {
                        <tr>
                            <td>@row.QuestionId</td>
                            <td>
                                <b>@row.Question</b>
                                <small class="benchmark-answer">@(row.Answer.Length <= 120 ? row.Answer : row.Answer[..120] + "…")</small>
                            </td>
                            <td>@row.LatencyMs ms</td>
                            <td>@row.TopScore.ToString("0.000")</td>
                            <td><span class="status @(row.Hit ? "completed" : "failed")">@(row.Hit ? "Yes" : "No")</span></td>
                            <td><span class="status @(row.Rejected ? "processing" : "completed")">@(row.Rejected ? "Yes" : "No")</span></td>
                            <td><span class="status @(row.ExpectationMet ? "completed" : "failed")">@(row.ExpectationMet ? "OK" : "Fail")</span></td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </section>
    </div>
}

@section Scripts {
@if (Model.SelectedRun is not null)
{
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js"></script>
<script>
(() => {
    const data = @Html.Raw(Model.ChartJson);
    if (!data.latency) return;
    const green = '#176b52';
    const amber = '#f1b94b';
    const red = '#c84b4b';
    const muted = '#66716c';
    const ink = '#18201d';
    const baseOptions = {
        responsive: true,
        plugins: { legend: { display: false }, tooltip: { backgroundColor: ink } },
        scales: {
            x: { ticks: { color: muted }, grid: { display: false } },
            y: { beginAtZero: true, ticks: { color: muted, precision: 0 }, grid: { color: '#e8eee9' } }
        }
    };

    new Chart(document.getElementById('latencyChart'), {
        type: 'bar',
        data: {
            labels: data.latency.labels,
            datasets: [{
                label: 'Latency (ms)',
                data: data.latency.values,
                backgroundColor: green,
                borderRadius: 6
            }]
        },
        options: baseOptions
    });

    new Chart(document.getElementById('hitRejectChart'), {
        type: 'doughnut',
        data: {
            labels: data.hitReject.labels,
            datasets: [{
                data: data.hitReject.values,
                backgroundColor: [green, amber, red],
                borderWidth: 0
            }]
        },
        options: {
            responsive: true,
            plugins: { legend: { position: 'bottom', labels: { color: muted } } }
        }
    });

    new Chart(document.getElementById('topScoreChart'), {
        type: 'line',
        data: {
            labels: data.topScore.labels,
            datasets: [{
                label: 'TopScore',
                data: data.topScore.values,
                borderColor: green,
                backgroundColor: 'rgba(23,107,82,.12)',
                fill: true,
                tension: .3,
                pointRadius: 3
            }]
        },
        options: {
            responsive: true,
            plugins: { legend: { display: false }, tooltip: { backgroundColor: ink } },
            scales: {
                x: { ticks: { color: muted }, grid: { display: false } },
                y: { beginAtZero: true, max: 1, ticks: { color: muted }, grid: { color: '#e8eee9' } }
            }
        }
    });
})();
</script>
}
}
