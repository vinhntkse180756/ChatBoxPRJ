@page
@model ChatBoxPRJ.Pages.Admin.CoursesModel
@{ ViewData["Title"] = "Môn học"; }
<div class="page-heading"><div><span class="eyebrow">ACADEMIC CATALOG</span><h1>Quản lý môn học</h1><p>Admin tạo, sửa và xóa môn học. Xóa môn sẽ xóa cả phân công và tài liệu liên quan.</p></div></div>
@if (Model.Flash is not null) { <div class="alert alert-info">@Model.Flash</div> }
<div class="split-layout"><section class="panel"><h2>Tạo môn học</h2><form method="post" class="form-stack"><label>Mã môn</label><input asp-for="Code" class="form-control"/><label>Tên môn</label><input asp-for="Name" class="form-control"/><label>Số tín chỉ</label><input asp-for="Credits" class="form-control"/><label>Mô tả</label><textarea asp-for="Description" class="form-control"></textarea><button class="btn btn-primary">Tạo môn học</button></form></section>
<section class="panel grow"><h2>Danh mục hiện có</h2>@foreach(var c in Model.Courses){<form method="post" asp-page-handler="Update" class="form-stack border rounded p-3 mb-3"><input type="hidden" name="EditId" value="@c.Id"/><div class="row g-2"><div class="col-md-2"><input name="Code" value="@c.Code" class="form-control"/></div><div class="col-md-4"><input name="Name" value="@c.Name" class="form-control"/></div><div class="col-md-2"><input name="Credits" value="@c.Credits" type="number" class="form-control"/></div><div class="col-md-4"><input name="Description" value="@c.Description" class="form-control"/></div></div><div class="d-flex gap-2"><button class="btn btn-outline-primary">Lưu sửa đổi</button><button class="btn btn-outline-danger" formaction="?handler=Delete&id=@c.Id" onclick="return confirm('Xóa môn học và toàn bộ tài liệu liên quan?')">Xóa</button></div></form>}</section></div>
