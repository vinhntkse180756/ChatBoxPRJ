@page
@model IndexModel
@{ ViewData["Title"] = "Trợ lý học tập từ tài liệu"; }
<section class="hero"><div class="hero-copy"><span class="eyebrow">RAG-POWERED LEARNING</span><h1>Hỏi đúng tài liệu.<br/><em>Học sâu hơn.</em></h1><p>Không gian hỏi đáp dành cho sinh viên, nơi mỗi câu trả lời đều được giới hạn trong tài liệu môn học và đi kèm nguồn trích dẫn rõ ràng.</p>
<div class="hero-actions">@if (User.Identity?.IsAuthenticated == true) { <a class="btn btn-primary btn-lg" href="@(User.IsInRole("Student") ? Url.Page("/Student/Chat") : User.IsInRole("Admin") ? Url.Page("/Admin/Index") : Url.Page("/Lecturer/Documents"))">Mở không gian của tôi →</a> } else { <a class="btn btn-primary btn-lg" asp-page="/Account/Register">Bắt đầu miễn phí →</a><a class="btn btn-outline-dark btn-lg" asp-page="/Account/Login">Tôi đã có tài khoản</a> }</div>
<div class="trust-row"><span>✓ Chỉ dùng tài liệu môn học</span><span>✓ Có nguồn trích dẫn</span><span>✓ Lưu lịch sử theo môn</span></div></div>
<div class="hero-visual"><div class="mock-window"><div class="mock-top"><i></i><i></i><i></i><span>PRN222 · Advanced .NET</span></div><div class="mock-body"><div class="mini-sidebar"><b>PRN222</b><span>DBI202</span><span>SWP391</span></div><div class="mini-chat"><div class="mini-bubble user">Dependency Injection là gì?</div><div class="mini-bubble bot">Dependency Injection là kỹ thuật cung cấp phụ thuộc từ bên ngoài, giúp giảm liên kết cứng và tăng khả năng kiểm thử.<div class="mini-source">📎 lecture-03.pdf · Trang 12</div></div></div></div></div><div class="floating-card"><span>✦</span><div><b>Grounded answer</b><small>Độ tương đồng 92%</small></div></div></div></section>
<section class="stats"><div><b>350</b><span>từ mỗi chunk</span></div><div><b>50</b><span>từ overlap</span></div><div><b>0.7</b><span>ngưỡng an toàn</span></div><div><b>SHA-256</b><span>chống tài liệu trùng</span></div></section>
<section class="landing-section"><span class="eyebrow">MỘT LUỒNG HỌC TẬP LIỀN MẠCH</span><h2>Từ tài liệu giảng viên đến câu trả lời có căn cứ</h2><div class="step-grid"><article><span>01</span><h3>Đưa tri thức vào hệ thống</h3><p>Giảng viên upload PDF/DOCX. Hệ thống tự trích xuất, chia đoạn và lập chỉ mục.</p></article><article><span>02</span><h3>Chọn môn và đặt câu hỏi</h3><p>Sinh viên tự do chọn môn. Mỗi phiên chat được khóa đúng ngữ cảnh môn học.</p></article><article><span>03</span><h3>Kiểm chứng ngay tại nguồn</h3><p>Câu trả lời kèm tên tệp, trang, đoạn và phần văn bản gốc được sử dụng.</p></article></div></section>
