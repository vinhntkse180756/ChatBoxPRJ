{
  "ConnectionStrings": {
    "ChatBoxDb": "Server=(localdb)\\MSSQLLocalDB;Database=StudentChatBoxDb;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=True;Connect Timeout=10"
  },
  "SeedAdmin": {
    "Code": "admin",
    "Email": "admin@chatbox.local",
    "Password": "Admin@123"
  },
  "Storage": {
    "RootPath": "App_Data/Uploads"
  },
  "Rag": {
    "SimilarityThreshold": 0.15,
    "TopK": 5,
    "ChunkWords": 350,
    "OverlapWords": 50
  },
  "AI": {
    "Provider": "Gemini",
    "GeminiApiKey": "YOUR_API_KEY",
    "EmbeddingModel": "gemini-embedding-001",
    "ChatModel": "gemini-2.5-flash"
  },
  "VectorStore": {
    "Provider": "SqlServer",
    "Description": "Vectors are stored in DocumentChunks.VectorJson"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
