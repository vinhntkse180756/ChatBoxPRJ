@page
@model Presentation.Pages.Account.LoginModel
@{ ViewData["Title"] = "Đăng nhập"; }
<div class="auth-shell">
    <section class="auth-card">
        <div class="eyebrow">STUDENT KNOWLEDGE HUB</div>
        <h1>Chào mừng trở lại</h1>
        <p class="text-muted">Đăng nhập để tiếp tục vào không gian học tập của bạn.</p>
        @if (Model.ErrorMessage is not null) { <div class="alert alert-danger">@Model.ErrorMessage</div> }
        <form method="post" class="form-stack">
            <input type="hidden" asp-for="ReturnUrl" />
            <label asp-for="Login">Mã định danh hoặc email</label>
            <input asp-for="Login" class="form-control" autocomplete="username" placeholder="SE123456 / email@fpt.edu.vn" />
            <span asp-validation-for="Login" class="text-danger"></span>
            <label asp-for="Password">Mật khẩu</label>
            <input asp-for="Password" class="form-control" autocomplete="current-password" />
            <button class="btn btn-primary btn-lg" type="submit">Đăng nhập</button>
        </form>
        <p class="auth-foot">Chưa có tài khoản sinh viên? <a asp-page="/Account/Register">Đăng ký ngay</a></p>
    </section>
</div>
