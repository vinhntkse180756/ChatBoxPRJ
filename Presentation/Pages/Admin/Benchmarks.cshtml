@page
@model Presentation.Pages.Admin.BenchmarksModel
@{ ViewData["Title"] = "Benchmarks & Metrics"; }
<div class="page-heading" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 16px; margin-bottom: 24px;">
    <div>
        <span class="eyebrow">EVALUATION</span>
        <h1>Benchmarks &amp; Metrics</h1>
        <p>Chạy test set RAG và đo Latency, TopScore, Hit, Reject (Admin only).</p>
    </div>
    <div style="background: #fff; padding: 12px 18px; border: 1px solid var(--line); border-radius: 12px; box-shadow: 0 4px 10px rgba(0,0,0,0.03);">
        <form method="post" enctype="multipart/form-data" asp-page-handler="UploadTestSet" style="display: flex; align-items: center; gap: 10px; margin: 0;">
            <div style="display: flex; flex-direction: column;">
                <label style="font-size: 0.72rem; font-weight: 700; color: var(--muted); margin-bottom: 3px;">Tải lên Testset JSON</label>
                <input type="file" name="UploadTestSet" accept=".json" required style="font-size: 0.8rem; max-width: 180px;" />
            </div>
            <button class="btn btn-sm btn-outline-primary" type="submit" style="border-radius: 6px; padding: 6px 12px; font-size: 0.82rem; font-weight: 600; margin-top: 15px; cursor: pointer;">Cập nhật</button>
        </form>
    </div>
</div>

@if (Model.Flash is not null)
{
    <div class="alert alert-@(Model.FlashType ?? "info")">@Model.Flash</div>
}

<div class="panel report-filter benchmark-filter">
    <form method="get" class="benchmark-filter-row" id="courseFilterForm">
        <div class="benchmark-field">
            <label asp-for="CourseId">Môn học</label>
            <select asp-for="CourseId" asp-items="Model.CourseOptions" class="form-select" onchange="this.form.submit()">
                <option value="">— Chọn môn —</option>
            </select>
        </div>
    </form>
    <form id="benchmarkRunForm" method="post" asp-page-handler="Run" class="benchmark-filter-row" style="flex-wrap: wrap; gap: 15px; width: 100%;">
        <input type="hidden" asp-for="CourseId" />
        <div class="benchmark-field" style="flex: 1 1 100%; margin-top: 10px;">
            <label style="font-weight: 600; display: block; margin-bottom: 8px;">Chọn tài liệu (Cấu hình RAG) muốn so sánh:</label>
            <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 8px;">
                @if (Model.CompletedDocuments.Any())
                {
                    @for (int i = 0; i < Model.CompletedDocuments.Count; i++)
                    {
                        var doc = Model.CompletedDocuments[i];
                        <label style="display: flex; align-items: flex-start; gap: 8px; font-weight: normal; cursor: pointer; padding: 6px; border: 1px solid #ddd; border-radius: 4px; background: #fafafa;">
                            <input type="checkbox" name="SelectedDocumentIds" value="@doc.Id" @(i == 0 ? "checked" : "") style="margin-top: 3px;" />
                            <div>
                                <b style="display: block; font-size: 0.9em; word-break: break-all;">@doc.FileName</b>
                                <small style="display: block; color: #555; font-size: 0.8em; margin-top: 2px;">
                                    ✂️ @doc.ChunkingStrategy · 🔢 @doc.EmbeddingModel
                                </small>
                            </div>
                        </label>
                    }
                }
                else
                {
                    <p style="color: #dd4b39; font-size: 0.9em;">(Không tìm thấy tài liệu Completed nào cho môn này. Vui lòng upload tài liệu trước.)</p>
                }
            </div>
        </div>
        <div class="benchmark-field" style="flex: 1 1 100%; margin-top: 10px;">
            <label style="font-weight: 600; display: block; margin-bottom: 8px;">Chọn các AI Model muốn so sánh:</label>
            <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 8px;">
                @foreach (var modelName in Presentation.Pages.Admin.BenchmarksModel.AvailableModels)
                {
                    <label style="display: flex; align-items: center; gap: 8px; font-weight: normal; cursor: pointer;">
                        <input type="checkbox" name="SelectedModels" value="@modelName" 
                               @(modelName == "gemini-3.1-flash-lite" ? "checked" : "") />
                        <span>@modelName</span>
                    </label>
                }
            </div>
        </div>
        <div class="benchmark-actions" style="margin-top: 15px; width: 100%; display: flex; justify-content: flex-end;">
            <button class="btn btn-primary" type="submit" id="btnSubmitBenchmark">Chạy benchmark</button>
        </div>
    </form>
    <p class="benchmark-hint">Test set: <code>Data/benchmark-questions.json</code> · Cần ≥ 1 tài liệu Completed trên môn đã chọn.</p>
</div>

@if (Model.SelectedRun is null)
{
    <div class="empty-state compact panel grow">
        <span>📉</span>
        <h2>Chưa có lần chạy nào</h2>
        <p>Chọn môn/tài liệu rồi bấm <b>Chạy benchmark</b>.</p>
    </div>
}
else
{
    var run = Model.SelectedRun;
    <div class="report-kpi-grid" style="grid-template-columns: repeat(auto-fit, minmax(130px, 1fr)); gap: 15px; margin-bottom: 20px;">
        <article class="report-kpi"><span>Tổng số câu</span><b>@run.QuestionCount</b></article>
        <article class="report-kpi"><span>Hit</span><b>@run.HitCount</b></article>
        <article class="report-kpi"><span>Reject</span><b>@run.RejectCount</b></article>
        <article class="report-kpi"><span>Đúng kỳ vọng</span><b>@run.ExpectationMetCount</b></article>
        <article class="report-kpi accent"><span>Avg Latency</span><b>@run.AverageLatencyMs.ToString("0") ms</b></article>
        <article class="report-kpi accent"><span>Avg TTFT</span><b>@run.AverageTtftMs.ToString("0") ms</b></article>
        <article class="report-kpi accent"><span>Avg Speed</span><b>@run.AverageChunksPerSecond.ToString("0.0") /s</b></article>
        <article class="report-kpi accent"><span>Avg TopScore</span><b>@run.AverageTopScore.ToString("0.000")</b></article>
    </div>

    <div class="report-chart-grid" style="margin-bottom:22px; display: grid; grid-template-columns: 1fr 1fr; gap: 20px;">
        <section class="panel report-chart-card">
            <h2>RAG Latency theo câu hỏi (ms)</h2>
            <p>Thời gian hoàn thành phản hồi tổng cộng (ms).</p>
            <canvas id="latencyChart" height="120"></canvas>
        </section>
        <section class="panel report-chart-card">
            <h2>Time to First Chunk (TTFT) (ms)</h2>
            <p>Thời gian bắt đầu nhận dữ liệu đầu tiên (ms).</p>
            <canvas id="ttftChart" height="120"></canvas>
        </section>
        <section class="panel report-chart-card">
            <h2>Tốc độ sinh phản hồi (Chunks/Sec)</h2>
            <p>Số lượng chunk từ mô hình trả về mỗi giây.</p>
            <canvas id="chunksSecChart" height="120"></canvas>
        </section>
        <section class="panel report-chart-card">
            <h2>TopScore theo câu hỏi</h2>
            <p>Điểm similarity cao nhất retrieve được cho từng câu.</p>
            <canvas id="topScoreChart" height="120"></canvas>
        </section>
    </div>

    <div class="split-layout">
        <section class="panel">
            <h2>Lần chạy gần đây</h2>
            @if (Model.RecentRuns.Count == 0)
            {
                <p class="text-muted">Chưa có dữ liệu.</p>
            }
            else
            {
                <div class="benchmark-run-list">
                @foreach (var item in Model.RecentRuns)
                {
                    <a class="benchmark-run-item @(run.Id == item.Id ? "active" : null)"
                       asp-page="/Admin/Benchmarks"
                       asp-route-runId="@item.Id"
                       asp-route-courseId="@Model.CourseId">
                        <b>@item.CourseCode</b>
                        <small style="display: block; margin-top: 4px;">Models: <code style="font-size:0.9em">@item.ModelName</code></small>
                        <small>@item.StartedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm") · @item.QuestionCount mẫu</small>
                        <span>Avg: @item.AverageLatencyMs.ToString("0") ms</span>
                    </a>
                }
                </div>
            }
        </section>

        <section class="panel grow">
            <div class="panel-title">
                <div>
                    <h2>Chi tiết lần chạy</h2>
                    <p>@run.CourseCode · @run.DocumentFileName · bởi @run.StartedByCode</p>
                </div>
            </div>
            <div class="table-wrap">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Model</th>
                            <th>Câu hỏi &amp; Trả về</th>
                            <th>Latency</th>
                            <th>TTFT</th>
                            <th>Speed</th>
                            <th>TopScore</th>
                            <th>Kỳ vọng</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var row in run.Results)
                    {
                        <tr>
                            <td>@row.QuestionId</td>
                            <td><span class="badge" style="background-color: #e8eee9; color: #176b52; padding: 4px 8px; border-radius: 4px; font-size: 0.85em; font-weight: 600;">@row.ModelName</span></td>
                            <td>
                                <b>@row.Question</b>
                                <small class="benchmark-answer" style="display: block; margin-top: 4px; color: #66716c;">@(row.Answer.Length <= 120 ? row.Answer : row.Answer[..120] + "…")</small>
                            </td>
                            <td>@row.LatencyMs ms</td>
                            <td>@row.TtftMs ms</td>
                            <td>@row.ChunksPerSecond.ToString("0.0")/s</td>
                            <td>@row.TopScore.ToString("0.000")</td>
                            <td><span class="status @(row.ExpectationMet ? "completed" : "failed")">@(row.ExpectationMet ? "OK" : "Fail")</span></td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </section>
    </div>
}

@section Scripts {
@if (Model.SelectedRun is not null)
{
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js"></script>
<script>
(() => {
    const data = @Html.Raw(Model.ChartJson);
    if (!data.latency) return;
    const green = '#176b52';
    const amber = '#f1b94b';
    const red = '#c84b4b';
    const muted = '#66716c';
    const ink = '#18201d';
    const baseOptions = {
        responsive: true,
        plugins: { legend: { display: true }, tooltip: { backgroundColor: ink } },
        scales: {
            x: { ticks: { color: muted }, grid: { display: false } },
            y: { beginAtZero: true, ticks: { color: muted, precision: 0 }, grid: { color: '#e8eee9' } }
        }
    };

    new Chart(document.getElementById('latencyChart'), {
        type: 'bar',
        data: {
            labels: data.latency.labels,
            datasets: data.latency.datasets
        },
        options: baseOptions
    });

    new Chart(document.getElementById('ttftChart'), {
        type: 'bar',
        data: {
            labels: data.ttft.labels,
            datasets: data.ttft.datasets
        },
        options: baseOptions
    });

    new Chart(document.getElementById('chunksSecChart'), {
        type: 'bar',
        data: {
            labels: data.chunksSec.labels,
            datasets: data.chunksSec.datasets
        },
        options: baseOptions
    });

    new Chart(document.getElementById('topScoreChart'), {
        type: 'line',
        data: {
            labels: data.topScore.labels,
            datasets: data.topScore.datasets
        },
        options: {
            ...baseOptions,
            scales: {
                x: { ticks: { color: muted }, grid: { display: false } },
                y: { beginAtZero: true, max: 1, ticks: { color: muted }, grid: { color: '#e8eee9' } }
            }
        }
    });
})();
</script>
}

<div id="loadingOverlay" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(255,255,255,0.85); z-index: 9999; justify-content: center; align-items: center; flex-direction: column;">
    <div style="border: 6px solid #f3f3f3; border-top: 6px solid var(--green, #176b52); border-radius: 50%; width: 50px; height: 50px; animation: spin 1s linear infinite; margin-bottom: 15px;"></div>
    <h3 style="margin: 0; color: var(--ink, #18201d); font-family: inherit; font-weight: 700;">Đang chạy benchmark...</h3>
    <p style="color: var(--muted, #66716c); margin-top: 8px; font-size: 0.95rem;">Quá trình kiểm thử RAG có thể mất vài phút. Vui lòng giữ tab này mở.</p>
</div>

<style>
@@keyframes spin {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
}
</style>

<script>
document.addEventListener("DOMContentLoaded", () => {
    const form = document.getElementById("benchmarkRunForm");
    const btn = document.getElementById("btnSubmitBenchmark");
    const overlay = document.getElementById("loadingOverlay");

    if (form && btn && overlay) {
        form.addEventListener("submit", (e) => {
            btn.disabled = true;
            btn.innerHTML = '<span style="display: inline-block; width: 12px; height: 12px; border: 2px solid #fff; border-top-color: transparent; border-radius: 50%; animation: spin 0.8s linear infinite; margin-right: 6px;"></span> Đang chạy...';
            overlay.style.display = "flex";
        });
    }
});
</script>
}
